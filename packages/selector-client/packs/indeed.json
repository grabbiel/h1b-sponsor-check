{
  "schema": 1,
  "platform": "indeed",
  "version": 2,
  "minExtensionVersion": "1.8.1",
  "pages": [
    {
      "kind": "search",
      "detect": [
        "[class*='jobsearch-JobCountAndSortPane-jobCount']",
        ".jobsearch-LeftPane"
      ],
      "slots": {
        "jobTitle": [
          "[class*='jobsearch-viewjoblayout'] .jobsearch-JobComponent .jobsearch-JobComponent-embeddedHeader .jobsearch-JobInfoHeader-title > span",
          "[data-testid='desktop-job-header'] [data-testid='vj-job-title']"
        ],
        "companyName": [
          "[class*='jobsearch-viewjoblayout'] .jobsearch-JobComponent .jobsearch-JobComponent-embeddedHeader [data-company-name='true']",
          "[data-testid='company-info-metadata'] a[href*='/cmp/']"
        ],
        "description": [
          "[class*='jobsearch-viewjoblayout'] .jobsearch-JobComponent #jobDescriptionText",
          ".simple-job-description-html"
        ],
        "listingCompanyName": [
          ".companyName",
          "[data-testid='company-name']"
        ],
        "activeListing": [
          ".companyName",
          ".vjs-highlight"
        ]
      }
    },
    {
      "kind": "job",
      "detect": [
        "#cmp-JobSearchInput-cmp-JobsHeader-what",
        "[data-testid='cmp-JobSearchInput']",
        "[action^='/cmp/']",
        "[for='cmp-JobSearchInput-cmp-JobsHeader-what']",
        "[data-tn-element='NonIAApplyButton']"
      ],
      "slots": {
        "jobTitle": [
          "[data-testid='jobDetailTitle'] > span",
          "[data-testid='jobDetailTitle'] > h3"
        ],
        "companyName": [
          "[itemprop='name']"
        ],
        "description": [
          ".JobDetailDescriptionScrollable",
          "[data-testid='jobDetailDescription']"
        ],
        "listingCompanyName": [
          ".companyName"
        ],
        "activeListing": [
          ".companyName"
        ]
      }
    }
  ],
  "contentHash": "d66a7b6cff4e5d6dd46abee0041c526627a4079580550b78ce2f422fad89f6e1"
}
