{
  "name": "visaspotter",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "visaspotter",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@visaspotter/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@visaspotter/index-builder": {
      "resolved": "packages/index-builder",
      "link": true
    },
    "packages/domain": {
      "name": "@visaspotter/domain",
      "version": "0.0.0"
    },
    "packages/index-builder": {
      "name": "@visaspotter/index-builder",
      "version": "0.0.0",
      "dependencies": {
        "@visaspotter/domain": "0.0.0"
      }
    }
  }
}
